# Purpose: Template for environment variables required by the multi-service setup.
# Copy this file to .env and fill in the actual values.

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=facedetection
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:securepassword@db:5432/facedetection

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Backend Security & CORS
SECRET_KEY=generate-a-very-long-and-secure-random-string-here
CORS_ORIGINS=http://localhost,http://localhost:8000,http://localhost:80

# Application Settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
